<!-- CubeOS: work glyph in an accent rounded square (iOS setup style header icon). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cube_mp_accent" />
            <corners android:radius="@dimen/cube_mp_tile_radius" />
            <size
                android:width="@dimen/cube_mp_tile_size"
                android:height="@dimen/cube_mp_tile_size" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/cube_mp_glyph_briefcase"
        android:gravity="center"
        android:width="@dimen/cube_mp_tile_glyph_size"
        android:height="@dimen/cube_mp_tile_glyph_size" />
</layer-list>
